# ==========================================
# Contato e Redes Sociais (Públicas)
# ==========================================
# Número do WhatsApp com DDI e DDD (ex: +5531999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# URL completa do perfil do Instagram
NEXT_PUBLIC_INSTAGRAM_URL=
# Mensagem padrão pré-preenchida no componente WhatsAppLink (opcional)
NEXT_PUBLIC_CTA_WHATSAPP_TEXT=

# ==========================================
# Analytics e Monitoramento (Públicas - Opcionais)
# ==========================================
# ID do Google Analytics (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# ID do Microsoft Clarity (ativo apenas em produção)
NEXT_PUBLIC_CLARITY_ID=

# ==========================================
# Sanity CMS (Públicas)
# ==========================================
# ID do projeto no Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset do Sanity (ex: production ou development)
NEXT_PUBLIC_SANITY_DATASET=production
# Versão da API do Sanity (ex: 2026-05-25)
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-25

# ==========================================
# Scripts CLI / Seed e Sincronização (Privadas)
# ==========================================
# Token com permissão de escrita no Sanity (NUNCA usar prefixo NEXT_PUBLIC_)
SANITY_API_WRITE_TOKEN=
# Defina como "true" para não sobrescrever os artigos do blog ao rodar npm run seed
SKIP_POSTS=false
